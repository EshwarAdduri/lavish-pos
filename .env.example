# Copy this file to ".env" and fill it in.  NEVER upload .env to GitHub.

# --- Local testing (your laptop) ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string

# Leave DATABASE_URL empty to use a local test database file (db.sqlite3).
# Paste your Supabase "Session pooler" connection string here to use the real cloud database.
DATABASE_URL=

# Owner account created automatically by "python manage.py ensure_owner" (and on every deploy if missing)
OWNER_USERNAME=owner
OWNER_PASSWORD=

# --- Production only (set these in Render, not here) ---
# ALLOWED_HOSTS=lavishshawarma.com,www.lavishshawarma.com
# CSRF_TRUSTED_ORIGINS=https://lavishshawarma.com,https://www.lavishshawarma.com
